{
  "info": {
    "_postman_id": "ec0aa8c0-2836-4bf4-bc66-5f0e57595d78",
    "name": "File Manager API",
    "description": "Sanctum cookie-based SPA auth flow for file-manager-backend. Run \"Get CSRF Cookie\" once at the start of every session (and again whenever you get a CSRF token mismatch) — everything else in this collection reads the resulting cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mirrors what axios does in the browser: read the XSRF-TOKEN cookie",
          "// Sanctum set, URL-decode it, and store it in an environment variable.",
          "// Stored as a variable (not injected directly as a header here) so it shows up",
          "// in the Headers tab / 'Copy as cURL' output — a header a script adds at",
          "// send-time via pm.request.headers is invisible to both of those.",
          "const xsrf = pm.cookies.get('XSRF-TOKEN');",
          "if (xsrf) {",
          "    pm.environment.set('xsrf_token', decodeURIComponent(xsrf));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Get CSRF Cookie",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Origin", "value": "{{frontend_origin}}" }
        ],
        "url": {
          "raw": "{{base_url}}/sanctum/csrf-cookie",
          "host": ["{{base_url}}"],
          "path": ["sanctum", "csrf-cookie"]
        },
        "description": "Seeds the XSRF-TOKEN and session cookies in Postman's cookie jar for {{base_url}}. Run this first."
      },
      "response": []
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{frontend_origin}}" },
          { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/register",
          "host": ["{{base_url}}"],
          "path": ["register"]
        },
        "description": "Creates a user and logs them in (session cookie). Returns 204 with no body on success."
      },
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{frontend_origin}}" },
          { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        },
        "description": "Returns 204 with no body on success. Requires 'Get CSRF Cookie' to have run first in this cookie jar."
      },
      "response": []
    },
    {
      "name": "Current User",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Origin", "value": "{{frontend_origin}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/user",
          "host": ["{{base_url}}"],
          "path": ["api", "user"]
        },
        "description": "Sanctum-authenticated via the session cookie set by Login/Register. Requires the Origin header to match a domain in SANCTUM_STATEFUL_DOMAINS."
      },
      "response": []
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "{{frontend_origin}}" },
          { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/logout",
          "host": ["{{base_url}}"],
          "path": ["logout"]
        },
        "description": "Invalidates the session. Returns 204 with no body on success."
      },
      "response": []
    }
  ]
}
